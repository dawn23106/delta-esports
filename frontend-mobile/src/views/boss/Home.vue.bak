<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { getServices } from '../../api/services'
import { createOrder } from '../../api/orders'
import { showToast, showLoadingToast, closeToast } from 'vant'
import { useAuthGuard } from '../../composables/useAuthGuard'
import { Motion } from 'motion-v'
import BentoGrid from '../../components/BentoGrid.vue'
import Confetti from '../../components/Confetti.vue'
import Card3D from '../../components/Card3D.vue'
import ImagesSlider from '../../components/ImagesSlider.vue'
import GradientButton from '../../components/ui/GradientButton.vue'

const services = ref<any[]>([])
const showOrder = ref(false)
const selectedService = ref<any>(null)
const gameMap = ref('')
const bossNote = ref('')
const loading = ref(false)
const { requireLogin } = useAuthGuard()
const confettiRef = ref<InstanceType<typeof Confetti> | null>(null)

const sliderImages = [
  'https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1200&h=600&fit=crop',
  'https://images.unsplash.com/photo-1511512578047-dfb367046420?w=1200&h=600&fit=crop',
  'https://images.unsplash.com/photo-1493711662062-fa541adb3fc8?w=1200&h=600&fit=crop',
  'https://images.unsplash.com/photo-1538481199705-c710c4e965fc?w=1200&h=600&fit=crop',
]

const catMeta: Record<string, { icon: string; gradient: string }> = {
  '陪玩专区': { icon: '🎯', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
  '监狱专区': { icon: '🔥', gradient: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)' },
  '趣味玩法': { icon: '🎪', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
}
const placeholderImg = (i: number) => {
  const imgs = [
    'https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1612404730960-5c71577fca11?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1592155931584-901ac15763e3?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1552820728-8b83bb6b2cf3?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1560419015-7c427e8ae5ba?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1577741314755-048d8525d31e?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1551103782-8ab2afd106c1?w=400&h=400&fit=crop',
    'https://images.unsplash.com/photo-1549036615-8494fa1da90d?w=400&h=400&fit=crop',
  ]
  return imgs[i % imgs.length]
}

const grouped = computed(() => {
  const groups: Record<string, any[]> = {}
  for (const s of services.value) {
    if (!groups[s.category]) groups[s.category] = []
    groups[s.category].push(s)
  }
  return Object.entries(groups).map(([name, items]) => ({
    name, icon: catMeta[name]?.icon || '🎮', gradient: catMeta[name]?.gradient || '', items,
  }))
})

// 伪随机卡片尺寸：宽高都随机
// 随机宽度和高度
// 模仿参考图：第一行1:1方卡 180px，二行高卡 180x220
// 自适应大小：卡片数量越少，单卡越大
// 对角线交替：每块3列偏移，自动排列
function cardGridStyle(i: number) {
  const block = Math.floor(i / 4) * 3  // 每块占3列，第N块从第N*3+1列开始
  const inBlock = i % 4
  if (inBlock === 0) return { gridRow: '1', gridColumn: `${block + 1} / span 2` }
  if (inBlock === 1) return { gridRow: '1', gridColumn: `${block + 3}` }
  if (inBlock === 2) return { gridRow: '2', gridColumn: `${block + 1}` }
  return { gridRow: '2', gridColumn: `${block + 2} / span 2` }
}
function imgPos(i: number) {
  return ['center 20%', 'center 80%', 'center 30%', 'center 70%'][i % 4]
}
// 宽卡文字放侧边：左上宽文字在右，右下宽文字在左
function cardLayoutClass(i: number) {
  const inBlock = i % 4
  if (inBlock === 0) return 'layout-img-left'   // 左上宽：图左字右
  if (inBlock === 3) return 'layout-img-right'   // 右下宽：图右字左
  return ''                                       // 窄卡：上下排列
}

async function load() {
  loading.value = true
  try { const r: any = await getServices(); services.value = Array.isArray(r) ? r : [] } catch { }
  loading.value = false
}

function pick(s: any) { selectedService.value = s; showOrder.value = true; gameMap.value = ''; bossNote.value = '' }

async function submit() {
  if (!await requireLogin('下单')) return
  showLoadingToast({ message: '下单中...', duration: 0 })
  try {
    await createOrder({ serviceId: selectedService.value.id, gameMap: gameMap.value || undefined, bossNote: bossNote.value || undefined })
    closeToast(); showToast({ message: '下单成功！', icon: 'success' }); showOrder.value = false
    confettiRef.value?.fire()
  } catch (e: any) { closeToast(); showToast({ message: e?.response?.data?.message || '失败', icon: 'fail' }) }
}

onMounted(load)
</script>

<template>
  <div class="page">
    <Confetti ref="confettiRef" />

    <!-- Hero Slider -->
    <section class="hero">
      <ImagesSlider :images="sliderImages" autoplay :interval="4000">
        <div class="hero-overlay">
          <h1 class="hero-title">沧月电竞</h1>
          <div class="hero-stats">
            <span>🎯 {{ services.length }}个服务</span>
            <span>⚡ 3位陪陪在线</span>
            <span>⭐ 98.6%好评</span>
          </div>
        </div>
      </ImagesSlider>
    </section>

    <!-- Loading -->
    <div v-if="loading" class="loading-wrap">
      <van-loading size="28" color="#6366f1" />
    </div>

    <!-- Categories -->
    <template v-else-if="services.length">
      <section v-for="group in grouped" :key="group.name" class="category-section">
        <div class="cat-header">
          <div class="cat-header-left">
            <span class="cat-icon">{{ group.icon }}</span>
            <div>
              <h2 class="cat-title">{{ group.name }}</h2>
              <p class="cat-count">{{ group.items.length }} 个精选服务</p>
            </div>
          </div>
        </div>
        <div class="h-scroll">
          <div class="h-scroll-row">
            <div
              v-for="(s, j) in group.items" :key="s.id"
              :class="['svc-card', cardLayoutClass(j)]"
              :style="cardGridStyle(j)"
              @click="pick(s)"
            >
              <Card3D :intensity="4">
                <div class="svc-img-wrap">
                  <img :src="s.coverImage || placeholderImg(j)" class="svc-img" :style="{ objectPosition: imgPos(j) }" />
                  <span class="svc-tag">{{ s.priceUnit === 'hour' ? '时' : '局' }}</span>
                  <span v-if="j === 0" class="svc-badge">推荐</span>
                </div>
                <div class="svc-body">
                  <h3 class="svc-name">{{ s.name }}</h3>
                  <div class="svc-footer">¥{{ s.basePrice }}</div>
                </div>
              </Card3D>
            </div>
          </div>
        </div>
      </section>
    </template>

    <div v-else class="empty">暂无服务</div>

    <div style="height:80px" />

    <!-- Order Sheet -->
    <van-action-sheet v-model:show="showOrder" title="确认下单" :close-on-click-overlay="true" :style="{ borderRadius:'20px 20px 0 0' }">
      <div class="sheet" v-if="selectedService">
        <div class="sheet-card">
          <div class="sheet-name">{{ selectedService.name }}</div>
          <div class="sheet-detail">
            <span>¥{{ selectedService.basePrice }}</span>
            <span>/{{ selectedService.priceUnit === 'hour' ? '小时' : '局' }}</span>
          </div>
          <div class="sheet-guarantee" v-if="selectedService.guaranteeDesc">🛡️ {{ selectedService.guaranteeDesc }}</div>
        </div>
        <van-field v-model="gameMap" label="地图" placeholder="选填" :border="true" input-align="right" />
        <van-field v-model="bossNote" label="备注" placeholder="有什么要求" type="textarea" rows="2" maxlength="200" show-word-limit :border="true" />
        <div class="sheet-tip">⏱️ 预计 5 分钟内匹配空闲陪陪</div>
        <GradientButton @click="submit" color-from="#6366f1" color-to="#8b5cf6">确认下单</GradientButton>
      </div>
    </van-action-sheet>

    <van-tabbar v-model="active" route :border="false" active-color="#6366f1" inactive-color="#94a3b8" safe-area-inset-bottom class="tabbar">
      <van-tabbar-item icon="home-o" to="/boss/home">首页</van-tabbar-item>
      <van-tabbar-item icon="friends-o" to="/boss/choose">选陪陪</van-tabbar-item>
      <van-tabbar-item icon="chat-o" to="/boss/messages">消息</van-tabbar-item>
      <van-tabbar-item icon="user-o" to="/boss/profile">我的</van-tabbar-item>
    </van-tabbar>
  </div>
</template>

<style scoped>
.page { min-height: 100vh; background: #f8f9fc; padding-bottom: 60px; }

/* Hero */
.hero { margin: 12px 0 8px; padding: 0 12px; }
.hero :deep(.slider-wrap) { border-radius: 12px; }
.hero-overlay { padding: 16px 20px; color: #fff; }
.hero-title { font-size: 22px; font-weight: 900; margin: 0 0 8px; letter-spacing: 2px; text-shadow: 0 2px 8px rgba(0,0,0,.5); }
.hero-stats { display: flex; gap: 14px; font-size: 11px; opacity: .8; }

/* Category */
.category-section { padding: 12px 0 0; }
.cat-header { margin-bottom: 6px; padding: 0 20px; }
.cat-header-left { display: flex; align-items: center; gap: 6px; }
.cat-icon { font-size: 22px; }
.cat-title { font-size: 16px; font-weight: 700; color: #222; margin: 0; }
.cat-count { font-size: 11px; color: #999; margin: 1px 0 0; }

/* 水平滚动两行 */
.h-scroll { overflow-x: auto; padding: 0 12px; -webkit-overflow-scrolling: touch; }
.h-scroll::-webkit-scrollbar { display: none; }
.h-scroll-row {
  display: grid; grid-auto-flow: column;
  grid-template-rows: 1fr 1fr; grid-auto-columns: 140px;
  gap: 8px; width: max-content; padding: 4px 0;
  height: 400px;
}

/* 卡片 */
.svc-card {
  background: #fff; border-radius: 10px; overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,.05); cursor: pointer;
  display: flex; flex-direction: column; min-height: 0;
  transition: box-shadow .25s, transform .25s;
  height: 100%;
}
.svc-card > * { min-height: 0; flex-shrink: 1; }
.svc-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.12); transform: translateY(-2px); }
.svc-card:hover .svc-img { transform: scale(1.05); }

.svc-img-wrap { overflow: hidden; flex: 1; min-height: 0; }

/* 宽卡：图+文左右排列 */
.layout-img-left { flex-direction: row !important; }
.layout-img-left .svc-img-wrap { width: 55%; flex: none; }
.layout-img-left .svc-body { width: 45%; flex: none; padding: 8px 10px !important; }
.layout-img-left .svc-name { font-size: 14px !important; }
.layout-img-left .svc-footer { font-size: 16px !important; }

.layout-img-right { flex-direction: row !important; }
.layout-img-right .svc-img-wrap { width: 55%; flex: none; order: 2; }
.layout-img-right .svc-body { width: 45%; flex: none; order: 1; padding: 8px 10px !important; }
.layout-img-right .svc-name { font-size: 14px !important; }
.layout-img-right .svc-footer { font-size: 16px !important; }
.svc-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
.svc-tag { position: absolute; bottom: 6px; right: 6px; padding: 2px 8px; border-radius: 6px; background: rgba(0,0,0,.45); color: #fff; font-size: 10px; }
.svc-badge { position: absolute; top: 6px; left: 6px; padding: 3px 8px; border-radius: 6px; background: #6366f1; color: #fff; font-size: 10px; font-weight: 600; }

.svc-body { padding: 6px 8px; flex: 1; display: flex; flex-direction: column; justify-content: center; text-align: center; overflow: hidden; min-height: 0; }
.svc-name { font-size: 14px; font-weight: 600; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.svc-footer { font-size: 13px; color: #6366f1; font-weight: 700; margin-top: 2px; }

/* Sheet */
.sheet { padding: 0 16px 28px; }
.sheet-card { background: linear-gradient(135deg, #f0f4ff, #faf5ff); border-radius: 14px; padding: 16px; margin-bottom: 14px; }
.sheet-name { font-size: 16px; font-weight: 700; color: #1e293b; }
.sheet-detail { margin-top: 6px; }
.sheet-detail span:first-child { font-size: 24px; font-weight: 800; color: #6366f1; }
.sheet-detail span:last-child { font-size: 13px; color: #64748b; }
.sheet-guarantee { font-size: 12px; color: #64748b; margin-top: 8px; padding: 8px 10px; background: rgba(99,102,241,.04); border-radius: 8px; }
.sheet-tip { margin: 12px 0 16px; padding: 10px; background: #fffbeb; border-radius: 10px; font-size: 12px; color: #92400e; }

.loading-wrap { display: flex; justify-content: center; padding: 80px 0; }
.empty { text-align: center; padding: 60px 0; color: #94a3b8; }

.tabbar { background: rgba(255,255,255,.9) !important; backdrop-filter: blur(20px) !important; border-top: 1px solid #f1f5f9 !important; }
</style>
